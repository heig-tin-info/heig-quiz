# Copy to .env -- never put a real secret in this example file (ADR-010).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
WORKER_MODE=all
LOG_LEVEL=info

# --- Database ---
# Two forms are accepted:
#   postgres://...          a real PostgreSQL (production, CI, and dev if you
#                           happen to have one running)
#   pglite://<dir>          an embedded PostgreSQL persisted on disk, which is
#                           what lets `pnpm dev` work with no container engine
#                           and nothing to install. The directory is relative
#                           to apps/api (gitignored) unless absolute.
# PGlite is single-process: stop the API before running `pnpm seed`.
# pg-boss cannot run on it, so the job queue is replaced by an in-process
# runner (see apps/api/src/jobs.ts). Refused under NODE_ENV=production.
DATABASE_URL=pglite://.data/pglite
# Apply the Drizzle migrations at startup. On by default, which is what you
# want both in dev and in the container image.
MIGRATE_ON_START=1
# Directory of the built SPA (apps/web/dist). Empty = API only, which is what
# you want when Vite serves the front end in dev.
#STATIC_DIR=

# --- Development login ---
# 1 = GET /app/auth/dev serves a persona picker that opens a real session
# without any identity provider, and the sign-in screen shows a button for it.
# config.ts REFUSES TO START if this is on under NODE_ENV=production.
AUTH_DEV_LOGIN=1

# The addresses the reverse proxy reaches the API from, and nothing else.
# `req.ip` is what the room restriction (F-EVAL-12) and the attempt journal
# read, and Caddy APPENDS to X-Forwarded-For, so the entry to believe is the
# last one: fastify stops at the first hop that is not listed here. Names
# (`loopback`, `linklocal`, `uniquelocal`), addresses and CIDRs, comma
# separated. Never list a range a student machine can sit on.
# TRUSTED_PROXIES=loopback,172.16.0.0/12

# Bearer token for GET /metrics (Prometheus). Empty — the default — leaves
# the endpoint to an ADMIN SESSION; it is never public, because the default
# collectors publish the command line, the versions and the memory profile.
#   curl -H "Authorization: Bearer $METRICS_TOKEN" https://quiz.example.ch/metrics
# METRICS_TOKEN=

# --- OIDC: local Keycloak in dev, Switch edu-ID in production ---
# This path stays the real one; the dev login above is a shortcut, not a
# replacement. Frontend dev with Vite/HMR: PUBLIC_URL is :5173, which proxies
# /app to :3000. Both callbacks are allowed by the dev realm
# (infra/keycloak/quiz-dev-realm.json).
PUBLIC_URL=http://localhost:5173
OIDC_ISSUER=http://localhost:8080/realms/quiz-dev
OIDC_CLIENT_ID=quiz
OIDC_CLIENT_SECRET=dev-secret-not-for-production
COOKIE_SECRET=dev-cookie-secret-change-me
# `private_key_jwt` client authentication (what SWITCH recommends): PKCS8
# private key whose public JWK is registered in the Resource Registry. Empty =
# client_secret authentication, which is what the dev Keycloak uses.
#OIDC_PRIVATE_KEY_PATH=secrets/eduid-private-key.pem
#OIDC_PRIVATE_KEY_KID=quiz-eduid-2026
# Idle timeout: sessions renew while in use (sliding expiry). Max 720 (30 days).
SESSION_TTL_HOURS=12

# Super administrator (manages teachers from the admin screen).
SUPER_ADMIN_EMAIL=admin@heig-vd.ch

# --- Question assets (images pasted into a question) ---
# Where the uploaded images live. Files are named after their sha256, so the
# store is content-addressed and a backup is a plain rsync. Gitignored in dev.
#ASSETS_DIR=.data/assets
# Hard cap on one uploaded image, in bytes (5 MB).
#ASSETS_MAX_BYTES=5000000

# --- Ticker ---
# Period of the single ticker, in milliseconds. One second is what the live
# evaluation clock needs (docs/spec/05-architecture.md, 5.4).
#TICK_MS=1000

# --- Code runner (PLAN-MVP §1.7) -------------------------------------------
# stub: no container engine needed; a code question is still authorable,
# playable and releasable, and its grading is proposed for a manual review.
# http: talks to the runner service, and RUNNER_URL becomes mandatory.
#RUNNER_MODE=stub
#RUNNER_URL=http://127.0.0.1:8090
#RUNNER_TIMEOUT_MS=30000
