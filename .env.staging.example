# Copy to .env.staging (chmod 600). Never put a real secret in this file.
# Staging runs in NODE_ENV=production, so every production refusal of
# config.ts applies here too: no AUTH_DEV_LOGIN, no pglite, no dev secret.
LOG_LEVEL=info
SESSION_TTL_HOURS=12

# Generate with: openssl rand -base64 32 -- NOT production's values.
POSTGRES_PASSWORD=
COOKIE_SECRET=

SUPER_ADMIN_EMAIL=

# Who may sign in (ADR-028): addresses and @domain entries, comma-separated.
# Staging holds a copy of production's data: keep this to the developers.
# The super administrator is always admitted.
LOGIN_ALLOWLIST=

# --- OIDC (Switch edu-ID) ---
# The production client with a second redirect URI registered in the SWITCH
# Resource Registry, https://quiz.dev.chevallier.io/app/auth/callback -- or a
# client of its own. Same private key and kid as production.
OIDC_ISSUER=https://login.eduid.ch/
OIDC_CLIENT_ID=
OIDC_PRIVATE_KEY_PATH=secrets/eduid-private-key.pem
OIDC_PRIVATE_KEY_KID=hgc-eduid-2026

# --- Code runner (ADR-016) ---
# `stub` by default: a code question is graded as a PROPOSED grade, and
# staging never loads production's runner during an exam. To test the runner
# for real, point it at a staging runner with a token of its own -- never at
# production's.
RUNNER_MODE=stub
#RUNNER_URL=
#RUNNER_TOKEN=

# --- Notification channels (ADR-030) ---
# Leave the Scaleway and Teams variables UNSET: staging holds a copy of
# production's accounts, and must never e-mail or message a real student.
# E-mails are then logged (dry run) and Teams is reported as not available.
