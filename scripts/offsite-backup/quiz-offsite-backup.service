# srv's user unit (application VM): push the backups of every service to the
# off-site borg repository (#235, deployment.md §6). Installed by hand into
# ~/.config/systemd/user/; started by quiz-offsite-backup.timer. A failure
# leaves the unit failed, with the reason in
# `journalctl --user -u quiz-offsite-backup`, and the app's `offsite` check
# reads it from the report.
[Unit]
Description=quiz — push the backups to the off-site borg repository

[Service]
Type=oneshot
ExecStart=/srv/quiz/scripts/offsite-backup/push.sh /srv/quiz/backup-status/offsite.json
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
