# Every hour at :15 UTC, give or take five minutes: after quiz's hourly dump
# (at the top of the hour, a few seconds; RPO 1 h, owner's decision of
# 2026-11-21), and, on the night's runs, after evaluation-tb's dump (03:17
# UTC) and the engine pull (03:00–05:00). A `pg_dump -Fc` compresses each
# table as one stream, so a table touched in the hour is a new blob for
# borg: an hour appends close to a whole dump (~25 MB in 2026-11), about
# 0.6 GB a day until the workstation's prune and compact (deployment guide
# §6). A run missed while the VM was down is caught up at boot (Persistent).
[Unit]
Description=quiz — hourly push of the backups to the off-site borg repository

[Timer]
OnCalendar=*-*-* *:15:00 UTC
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
