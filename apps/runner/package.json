{
  "name": "@quiz/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "images": "bash images/build.sh"
  },
  "dependencies": {
    "@quiz/core": "workspace:*",
    "fastify": "^5.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
