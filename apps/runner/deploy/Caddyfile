# The runner's front door on the code VM (ADR-016): the VM's own name,
# code.chevallier.io, on port 8443 — the :443 site block belongs to
# heig-codespace and stays untouched, and Caddy reuses the certificate it
# already holds for that name.
#
# That VM's /etc/caddy/Caddyfile belongs to heig-codespace; it gained one
# `import /etc/caddy/conf.d/*.caddy` line and this fragment lives there:
#   sudo cp Caddyfile /etc/caddy/conf.d/quiz-runner.caddy && sudo systemctl reload caddy
#
# Two gates, both required: only the quiz VM may talk to it (the source
# address of a TLS connection cannot be spoofed), and the API must present the
# shared RUNNER_TOKEN, which the runner itself checks. Losing either one
# leaves the other.
#
# The allowlist is the quiz VM's address, 128.140.71.35 since 2026-09-25. When
# the quiz VM moves, add the new address here AND in
# /etc/caddy/conf.d/quiz-runner.caddy on the code VM before the switch, then
# drop the old one.
https://code.chevallier.io:8443 {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@quiz remote_ip 128.140.71.35
	handle @quiz {
		reverse_proxy 127.0.0.1:3200
	}

	handle {
		respond 403
	}
}
