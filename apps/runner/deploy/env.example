# /etc/quiz-runner/env — chmod 600, root only. Read by the quadlet
# (quiz-runner.container). Never put a real secret in this example file.
#
# The SAME value as RUNNER_TOKEN in /srv/quiz/.env.prod on the quiz VM.
# Generate with: openssl rand -hex 32
RUNNER_TOKEN=

# Rootful engine on this VM: `--userns=auto` is always available, no probe.
RUNNER_USERNS_AUTO=true
PODMAN_SOCKET=/run/podman/podman.sock
# gVisor (N-SEC-06): once deploy/install-gvisor.sh has run and the quadlet
# drop-in deploy/gvisor/quiz-runner.container.d-gvisor.conf is installed,
# replace the line above with the two below. The runner then refuses to start
# unless a hardened container runs under gVisor (README, gVisor). Until then
# it warns, at startup and on every /health, that gVisor is not in use.
#PODMAN_SOCKET=/run/quiz-runner-podman/podman.sock
#RUNNER_RUNTIME=runsc
# RUNNER_SECCOMP is set by the quadlet (/etc/quiz-runner/seccomp.json, installed
# by deploy.sh): a host path, since the Podman server is what opens it.
# RUNNER_CGROUP_PARENT=quiz-runner.slice is set by the quadlet too (M6-05).
# Its memory lines (infra/engine/quiz-runner.slice) are sized for the two
# values below and RUNNER_MAX_MEMORY_MB: raise them together. Each container
# is 1 CPU and `memoryMb`.
RUNNER_CONCURRENCY=2
RUNNER_QUEUE_MAX=32
LOG_LEVEL=info
