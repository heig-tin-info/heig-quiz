# Podman quadlet of the code runner (ADR-016). Installed by deploy.sh as
# /etc/containers/systemd/quiz-runner.container; systemd generates
# quiz-runner.service from it at daemon-reload.
#
# The service is the only process on this VM that talks to the rootful Podman
# socket besides the codespace portal. It holds no secret other than the
# shared RUNNER_TOKEN of /etc/quiz-runner/env, reaches no database, and the
# containers it starts get the closed environment of invariant 10.
[Unit]
Description=quiz — code execution service (hardened Podman containers)
Documentation=https://github.com/heig-tin-info/heig-quiz/blob/main/apps/runner/README.md
Requires=podman.socket
After=podman.socket network-online.target

[Container]
Image=ghcr.io/heig-tin-info/quiz-runner:latest
ContainerName=quiz-runner
# Pulled by deploy.sh with the CI's ephemeral token; never at boot.
Pull=never
EnvironmentFile=/etc/quiz-runner/env
Environment=NODE_ENV=production
# Loopback only: Caddy is the single way in from outside (deploy/Caddyfile).
# Host networking, so 127.0.0.1 here IS the host's and nothing is NAT-ed.
Network=host
Environment=HOST=127.0.0.1
Environment=PORT=3200
# The two things the service gets from the host, and the containers it then
# starts mount nothing at all. The seccomp profile is opened by the Podman
# SERVER (`--security-opt seccomp=<path>` is a host path with `--remote`), so
# deploy.sh installs the repository's copy at a path that exists on both
# sides, and the service checks it at startup on its side of the mount.
Volume=/run/podman/podman.sock:/run/podman/podman.sock
Volume=/etc/quiz-runner/seccomp.json:/etc/quiz-runner/seccomp.json:ro
Environment=RUNNER_SECCOMP=/etc/quiz-runner/seccomp.json
# The service itself: nothing to write, nothing to escalate.
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL
PodmanArgs=--memory=512m

[Service]
Restart=always
RestartSec=3
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
