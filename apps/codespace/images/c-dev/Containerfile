# heig-codespace student image: C and C++, gdb, code-server.
# Construite par : podman --remote --url unix:///run/podman/podman.sock \
#                    build -t codespace/c-dev images/c-dev
# Run by images/c-dev/run-hardened.sh (hardening is mandatory, CLAUDE.md invariant 3).

# --- Stage 1: building the .vsix of the status-bar extension ----------------
# Packaging only: the extension is plain JavaScript, with no dependency and no
# bundler. `@vscode/vsce` is pinned; it is the only network access of this
# stage and it leaves nothing in the final image, which only gets the .vsix.
FROM docker.io/library/node:22-slim@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96 AS vsix
ARG VSCE_VERSION=4.0.0
ARG EXT_STATUSBAR_ID=heig.codespace-statusbar
ARG EXT_STATUSBAR_VERSION=0.3.0
WORKDIR /ext
COPY extension/ /ext/
# `--allow-missing-repository`: the extension is not published, it has no
# repository of its own. Without that flag vsce refuses to package.
RUN npx --yes "@vscode/vsce@${VSCE_VERSION}" package \
        --allow-missing-repository \
        --out "/${EXT_STATUSBAR_ID}-${EXT_STATUSBAR_VERSION}.vsix" && \
    test -s "/${EXT_STATUSBAR_ID}-${EXT_STATUSBAR_VERSION}.vsix"

# --- Stage 2: Baygon, the functional-test runner of the C labs (#1102) ------
# A venv under /opt/baygon, built on the same pinned base as the student image
# so that its interpreter path (/usr/bin/python3, Python 3.13) is the one the
# final stage installs. Every package is pinned by version AND hash in
# baygon/requirements.txt; wheels only (no compiler), no dependency resolution
# (--no-deps: the file is complete), no pip cache. pip itself is removed from
# the venv: only the venv crosses into the final image, never pip, the
# python3-venv package or the apt lists of this stage.
FROM docker.io/library/debian:trixie-slim@sha256:abc9cb88a5587630d7f915f47b23b0668fe250fbfc6457aa4d52b534c1bbf73f AS baygon
COPY baygon/requirements.txt /opt/baygon-requirements.txt
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-venv && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m venv /opt/baygon && \
    /opt/baygon/bin/pip install --no-cache-dir --disable-pip-version-check \
        --require-hashes --only-binary=:all: --no-deps \
        -r /opt/baygon-requirements.txt && \
    /opt/baygon/bin/pip uninstall -y --disable-pip-version-check pip && \
    mv /opt/baygon-requirements.txt /opt/baygon/requirements.txt && \
    /opt/baygon/bin/baygon --version

# --- Stage 3: the student image ---------------------------------------------
# Debian 13 "trixie", stable as of 2026-09-17, pinned by digest.
FROM docker.io/library/debian:trixie-slim@sha256:abc9cb88a5587630d7f915f47b23b0668fe250fbfc6457aa4d52b534c1bbf73f

# Pinned code-server version (GitHub release coder/code-server).
ARG CS_VERSION=4.137.0
# Open VSX extensions, pinned by identifier only: Open VSX does not guarantee
# that an old version stays available. The version resolved at build time is
# written to /etc/code-server/extensions.lock.
ARG EXT_CLANGD=llvm-vs-code-extensions.vscode-clangd
ARG EXT_DEBUG=webfreak.debug
# Local extension, built by the `vsix` stage above: the portal status bar
# (deadline countdown, return button). It is not published, so it is installed
# from the .vsix and not from Open VSX.
ARG EXT_STATUSBAR=heig.codespace-statusbar
ARG EXT_STATUSBAR_VERSION=0.3.0

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    TZ=Europe/Zurich

# 0. The "slim" image excludes /usr/share/man through dpkg: we put it back
#    BEFORE installing anything, otherwise manpages-dev is installed without
#    its pages. The other exclusions (doc, locale, info) are kept.
RUN printf 'path-include /usr/share/man/*\n' > /etc/dpkg/dpkg.cfg.d/heig-man-pages

# 1. C and C++ toolchains, gdb, git, manual pages, clangd.
#    g++ is Debian's default, the same GCC as gcc (it brings libstdc++-dev;
#    libstdc++6 already ships the gdb pretty-printers of the standard library).
#    curl and ca-certificates serve the .deb download and the /healthz
#    acceptance test; procps and less the comfort of the terminal; python3
#    is the interpreter of Baygon (step 4b; gdb already pulls libpython3.13)
#    and of pytest.
#    python3-pytest serves the labs whose `make test` runs pytest: Debian's
#    package, so both `pytest` and `python3 -m pytest` work for /usr/bin/python3,
#    its byte-code compiled by the package's postinst. From the Debian mirror
#    like every package of this list: the hashed venv of stage 2 exists only
#    because Baygon is not packaged by Debian. Still no pip in the image.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        gdb \
        make \
        git \
        man-db \
        manpages-dev \
        clangd \
        libc6-dev \
        binutils \
        curl \
        ca-certificates \
        procps \
        less \
        python3 \
        python3-pytest && \
    rm -rf /var/lib/apt/lists/*

# 2. code-server from the GitHub release, pinned version.
RUN curl -fsSL -o /tmp/code-server.deb \
        "https://github.com/coder/code-server/releases/download/v${CS_VERSION}/code-server_${CS_VERSION}_amd64.deb" && \
    apt-get update && \
    apt-get install -y --no-install-recommends /tmp/code-server.deb && \
    rm -f /tmp/code-server.deb && \
    rm -rf /var/lib/apt/lists/* && \
    code-server --version

# 2b. No notebook support (audit L24): a notebook's HTML output runs script in
#     a webview on the portal's origin, shared by every session, as soon as the
#     .ipynb is opened. `ipynb` is the only bundled extension that contributes
#     a notebook type; `notebook-renderers` renders its HTML outputs. Deleted
#     here, at build time, so every rebuild drops them (README, § No notebook
#     support).
RUN rm -rf /usr/lib/code-server/lib/vscode/extensions/ipynb \
           /usr/lib/code-server/lib/vscode/extensions/notebook-renderers && \
    ! grep -l '"notebooks"' /usr/lib/code-server/lib/vscode/extensions/*/package.json

# 2c. Safe Exam Browser support in the workbench page (#1149, #1151): copy and
#     paste through SEB's isolated clipboard, and a battery indicator. The
#     script sits beside workbench.js, served by the same static route, and
#     workbench.html (read from disk on every request by VS Code's server)
#     loads it as a classic script before </head>: same origin, so the page's
#     CSP (`script-src 'self' …`) admits it. `?v=` is the file's hash: the
#     static route caches for a year under a URL that only changes with
#     code-server's version (README, § Safe Exam Browser in the workbench).
COPY seb-workbench.js /usr/lib/code-server/lib/vscode/out/vs/code/browser/workbench/seb-workbench.js
RUN dir=/usr/lib/code-server/lib/vscode/out/vs/code/browser/workbench && \
    v="$(sha256sum "$dir/seb-workbench.js" | cut -c1-12)" && \
    test "$(grep -c '</head>' "$dir/workbench.html")" = 1 && \
    sed -i "s#</head>#\t<script src=\"{{WORKBENCH_WEB_BASE_URL}}/out/vs/code/browser/workbench/seb-workbench.js?v=$v\"></script>\n\t</head>#" \
        "$dir/workbench.html" && \
    grep -q "seb-workbench.js?v=$v\"></script>" "$dir/workbench.html" && \
    chmod 0644 "$dir/seb-workbench.js" "$dir/workbench.html"

# 3. student user, uid 1000. /work is the volume mount point.
#    coder-logs is a link into the tmpfs: without it code-server throws at
#    start-up trying to write its logs on the read-only root. The rest of
#    ~/.local/share/code-server stays on the root, so the default extensions
#    directory is not writable.
RUN useradd --uid 1000 --create-home --shell /bin/bash student && \
    mkdir -p /work /home/student/.cache /home/student/.local/share/code-server && \
    ln -s /run/code-server/logs /home/student/.local/share/code-server/coder-logs && \
    chown -R 1000:1000 /work /home/student

# 4. Extensions preinstalled at build time from Open VSX (code-server's default
#    gallery). The directory is on the root, hence read-only at run time: it is
#    the only barrier that holds against a .vsix brought in by the student
#    (docs/history/analyse.md 3.2).
COPY --from=vsix /heig.codespace-statusbar-${EXT_STATUSBAR_VERSION}.vsix /tmp/codespace-statusbar.vsix
RUN mkdir -p /opt/code-server/extensions /tmp/cs-build /etc/code-server && \
    code-server \
        --extensions-dir /opt/code-server/extensions \
        --user-data-dir /tmp/cs-build \
        --force \
        --install-extension "${EXT_CLANGD}" \
        --install-extension "${EXT_DEBUG}" \
        --install-extension /tmp/codespace-statusbar.vsix && \
    code-server \
        --extensions-dir /opt/code-server/extensions \
        --user-data-dir /tmp/cs-build \
        --list-extensions --show-versions | tee /etc/code-server/extensions.lock && \
    grep -qi "^${EXT_CLANGD}@" /etc/code-server/extensions.lock && \
    grep -qi "^${EXT_DEBUG}@" /etc/code-server/extensions.lock && \
    grep -qi "^${EXT_STATUSBAR}@${EXT_STATUSBAR_VERSION}$" /etc/code-server/extensions.lock && \
    rm -f /tmp/codespace-statusbar.vsix && \
    rm -rf /tmp/cs-build /root/.config/code-server /root/.local && \
    chown -R root:root /opt/code-server && \
    chmod -R a-w /opt/code-server

# 4b. Baygon (#1102), from the `baygon` stage: root-owned and on the read-only
#     root like everything else, on PATH through /usr/local/bin. The venv's
#     .pyc files were compiled at install time, so Python never needs to write.
COPY --from=baygon /opt/baygon /opt/baygon
RUN ln -s /opt/baygon/bin/baygon /usr/local/bin/baygon && \
    baygon --version

# 5. Machine settings. Copied into the tmpfs user-data-dir by the entrypoint.
COPY settings.json /etc/code-server/settings.json
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0644 /etc/code-server/settings.json && \
    chmod 0755 /usr/local/bin/entrypoint.sh

# 5b. Resolver: with --dns=none Podman writes no /etc/resolv.conf and the libc
#     falls back to 127.0.0.1 with a five-second wait per attempt, so every
#     failed resolution (curl, git, clangd) blocks for five seconds.
#     The image ships a static resolv.conf with no nameserver at all, which
#     brings the failure back under a second. It must be laid down by COPY and
#     not by RUN: during a RUN, buildah mounts its own /etc/resolv.conf over it
#     and the write would be lost along with the mount.
COPY resolv.conf /etc/resolv.conf
RUN chmod 0644 /etc/resolv.conf

# 6. Default clangd settings, per language (clangd.yaml: -std=c17 for C,
#    -std=c++20 for C++). clangd only reads
#    $XDG_CONFIG_HOME/clangd/config.yaml (that is ~/.config/clangd/config.yaml)
#    and the project's .clangd files: the one source file is therefore dropped
#    in both useful places. ~/.config is on the read-only root; the entrypoint
#    copies the same file into the tmpfs XDG_CONFIG_HOME, which code-server, its
#    extension host and the integrated terminal all inherit.
COPY clangd.yaml /etc/clangd/config.yaml
RUN mkdir -p /home/student/.config/clangd && \
    cp /etc/clangd/config.yaml /home/student/.config/clangd/config.yaml && \
    chmod 0644 /etc/clangd/config.yaml /home/student/.config/clangd/config.yaml && \
    chown -R 1000:1000 /home/student/.config

USER 1000:1000
WORKDIR /work
EXPOSE 8080
ENV PAGER=less
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
