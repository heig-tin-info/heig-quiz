# /etc/quiz-codespace/<instance>/env — the portal's environment on the engine
# VM, one file per instance (prod, staging), chmod 600, root only. Read by the
# quadlet quiz-codespace-<instance>.container (EnvironmentFile=).
#
# A TEMPLATE: bootstrap.sh writes the instance's file from it ONCE, filling
# the @…@ values (the two secrets drawn from /dev/urandom), and never
# rewrites an existing file. Never put a real secret in this example.
#
# NOT here: set by the quadlet from lib.sh's instance table. Do not repeat
# them in this file, so that each value has one place to be read:
#   NODE_ENV=production, CODESPACE_INSTANCE, HOST=127.0.0.1, PORT,
#   PODMAN_URL, CODESPACE_NETWORK, CODESPACE_GATEWAY, CODESPACE_GIT_PORT,
#   DATABASE_PATH, VOLUMES_ROOT, SECCOMP_PROFILE, CODESPACE_CGROUP_PARENT.
#
# What loadConfig() (src/auth/config.ts) REFUSES under NODE_ENV=production,
# so the portal does not start: an EXAM_COOKIE_SECRET or a
# CODESPACE_LAUNCH_SECRET containing "change-me"; SEB_VERIFIER=simulated;
# an empty SEB_PUBLIC_ORIGIN; an empty TRUSTED_PROXY_IPS; TRUST_PROXY set;
# FORGE_KIND=forgejo or github; FORGE_KIND=quiz with a PLATFORM_URL not over
# https; and, in EVERY environment, GITHUB_APP_ID or
# GITHUB_APP_PRIVATE_KEY_PATH set (root invariant 15, ADR-078: no GitHub App
# key on this VM).

LOG_LEVEL=info
# This instance's public origin: https://code.chevallier.io (prod) or
# https://code-dev.chevallier.io (staging).
PUBLIC_URL=@PUBLIC_URL@

# --- the student containers --------------------------------------------------
# The AppArmor profile NAME, loaded by the deploy (infra/apparmor/codespace):
# what makes gdb work on kernel 7. Empty only on a host without AppArmor.
CODESPACE_APPARMOR_PROFILE=codespace
# Built on this VM by apps/codespace/images/build.sh, never pulled.
CODESPACE_IMAGE=codespace/c-dev:4.137.0
CODESPACE_DEFAULT_IMAGE=codespace/c-dev:4.137.0
# codespace.slice holds 2 GB for both instances: at 1536m, ONE session at a
# time on this VM; 768m gives two (RUNBOOK.md, Capacity).
CODESPACE_MEMORY=1536m
CODESPACE_CPUS=1
CODESPACE_PIDS_LIMIT=256

# --- session lifecycle (milliseconds) -----------------------------------------
SESSION_GRACE_MS=600000
SESSION_GC_INTERVAL_MS=60000
# The periodic snapshots are quiz-codespace-shadow@<instance>.timer's, as the
# host's root; the portal's own timer is pushed back to 24 h so there is a
# single periodic writer (its session-close snapshot stays).
SHADOW_INTERVAL_MS=86400000
SESSION_HEALTH_TIMEOUT_MS=30000

# --- forge ---------------------------------------------------------------------
# `quiz` (ADR-078, M6-10; also the default with PLATFORM_URL and
# CODESPACE_LAUNCH_SECRET set): the portal asks Quiz, at PLATFORM_URL, for an
# installation token scoped to one repository (`contents` only, in memory,
# until the deadline plus the grace), seeds a workspace from the student's
# private repository (or an online_seb project's distribution) and relays
# every push to GitHub, never forced. No GitHub App key on this VM, ever.
# `none`: a push lands in staging.git with its PushEvent (the proof of
# submission) and nothing is relayed; only a PUBLIC repository seeds.
# Production refuses `forgejo` and `github` (development forges).
FORGE_KIND=quiz

# --- the platform ---------------------------------------------------------------
# The HS256 secret shared with Quiz (CODESPACE_LAUNCH_SECRET in Quiz's
# .env.prod for prod, .env.staging for staging): the SAME value on both
# sides, DISTINCT per instance, at least 32 characters. Generated by
# bootstrap.sh (`openssl rand -hex 32`).
CODESPACE_LAUNCH_SECRET=@LAUNCH_SECRET@
# Quiz's public origin: https://quiz.chevallier.io (prod) or
# https://quiz.dev.chevallier.io (staging). The host of the .seb start URL,
# and the return link of the status bar's Close button.
PLATFORM_URL=@PLATFORM_URL@

# --- SEB ---------------------------------------------------------------------------
SEB_VERIFIER=real
# The origin SEB hashes, this instance's public origin.
SEB_PUBLIC_ORIGIN=@PUBLIC_URL@
# The .seb and its URL filter are Quiz's (D21, M6-07): the extra hosts are
# Quiz's SEB_EXTRA_ALLOWED_HOSTS, not this portal's.
# HMAC of the exam_session cookie. Generated by bootstrap.sh.
EXAM_COOKIE_SECRET=@EXAM_COOKIE_SECRET@
EXAM_COOKIE_MAX_AGE_MS=14400000

# --- the client address behind Caddy ----------------------------------------------
# Caddy dials from the loopback and appends X-Forwarded-For: this hop is
# trusted, so request.ip is the student's and the exam cookie's address
# binding is real. Required in production. TRUST_PROXY (development only) is
# refused there.
TRUSTED_PROXY_IPS=127.0.0.1
