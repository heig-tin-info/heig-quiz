{
  "name": "@quiz/codespace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portal of the online workspace: code-server in hardened Podman containers, SEB exam mode (ADR-047)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:integration": "CODESPACE_INTEGRATION=1 vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/http-proxy": "^11.3.0",
    "@quiz/contracts": "workspace:*",
    "@quiz/domain": "workspace:*",
    "@quiz/seb": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
