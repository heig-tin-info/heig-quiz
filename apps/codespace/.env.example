NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
PUBLIC_URL=http://localhost:3100
DATABASE_PATH=./var/codespace.sqlite

# Engine (always in remote mode, see docs/setup-workstation.md)
# Which portal this is on a shared Podman engine: its session containers are
# cs-<instance>-<id>, labelled heig-codespace.instance=<instance>, and it never
# sees nor removes another instance's (the engine VM runs prod and staging).
CODESPACE_INSTANCE=default
PODMAN_URL=unix:///run/podman/podman.sock
CODESPACE_NETWORK=codespace
CODESPACE_GATEWAY=10.77.0.254
CODESPACE_GIT_PORT=9418
VOLUMES_ROOT=./var/volumes
SECCOMP_PROFILE=./infra/seccomp/codespace.json
# AppArmor profile NAME (not a path): the kernel must already have it loaded.
# Source infra/apparmor/codespace, installed by classroom's deploy/bootstrap.sh and
# reloaded by classroom's deploy/push.sh. It is what makes gdb work again on kernel
# 7.0.0-31 (images/c-dev/README.md § AppArmor); production sets it to
# `codespace`.
# EMPTY HERE ON PURPOSE: the development workstation is WSL2, which has no
# AppArmor, and `podman run` refuses a profile name the kernel does not know.
# Empty = the --security-opt apparmor flag is not passed at all.
CODESPACE_APPARMOR_PROFILE=
CODESPACE_IMAGE=codespace/c-dev:4.137.0
CODESPACE_MEMORY=1536m
CODESPACE_CPUS=1
CODESPACE_PIDS_LIMIT=256

# Session lifecycle (milliseconds)
SESSION_GRACE_MS=600000
SESSION_GC_INTERVAL_MS=60000
SHADOW_INTERVAL_MS=180000
SESSION_HEALTH_TIMEOUT_MS=30000

# No login of its own (ADR-047, M6-03): a user exists only through the
# platform's launch token.

# Forge. `none` (the default): pushes stay in staging.git with their
# PushEvent, nothing is relayed. `forgejo` is the development forge of
# infra/compose.dev.yml. GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY_PATH are
# refused at startup: Quiz never uses heig-classroom's App (root invariant 15).
FORGE_KIND=none
FORGE_URL=http://localhost:3300
FORGE_TOKEN=
FORGE_USER=codespace

# --- Platform integration (Quiz, apps/api) ----------------------------------
# Shared HS256 secret, identical on both sides. Empty = integration disabled:
# /launch and /api/assignments/* answer 404 and no session can open.
# Thirty-two characters minimum. See docs/integration-classroom.md.
CODESPACE_LAUNCH_SECRET=dev-launch-secret-change-me-0123456789
# Public origin of the platform: startURL of the .seb files, and host allowed
# by SEB. The former name CLASSROOM_URL is still read as an alias.
PLATFORM_URL=http://localhost:3000
# Image of a synchronised assignment whose `image` is null.
CODESPACE_DEFAULT_IMAGE=codespace/c-dev:4.137.0

# SEB: "real" in production, "simulated" allowed outside production only
SEB_VERIFIER=simulated
# Origin on which SEB computes its hashes (analyse.md 4.6). Mandatory in
# production; empty in dev = rebuilt from the Host header.
SEB_PUBLIC_ORIGIN=
EXAM_COOKIE_SECRET=dev-exam-cookie-secret-change-me
EXAM_COOKIE_MAX_AGE_MS=14400000

# Addresses of the front ends allowed to speak for their client, comma
# separated, handed as a list to Fastify's trustProxy. Behind the Caddy of
# classroom's deploy/Caddyfile: 127.0.0.1. This is what makes request.ip the student's
# address, and therefore the exam cookie's address binding real
# (classroom's docs/deploy.md § 6). REQUIRED in production; empty in development, where
# there is no front end.
TRUSTED_PROXY_IPS=

# DEVELOPMENT ONLY. Makes request.ip controllable through X-Forwarded-For by
# ANYONE, which an end-to-end run needs in order to simulate a second
# workstation. loadConfig() refuses to start with NODE_ENV=production. When
# TRUSTED_PROXY_IPS is set it wins over this boolean.
TRUST_PROXY=
