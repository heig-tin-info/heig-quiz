site/

# Self-hosted WebAssembly language runtimes (apps/web/scripts/fetch-runtimes.mjs)
/apps/web/public/runtimes/
# Blockly's media, copied from the package (apps/web/scripts/copy-blockly-media.mjs)
/apps/web/public/blockly-media/
# pdf.js's character maps, fonts, ICC profiles and decoders, copied from the package (apps/web/scripts/copy-pdfjs-assets.mjs)
/apps/web/public/pdfjs/
# The published JSON Schemas, generated from @quiz/contracts (apps/web/scripts/write-schemas.mjs)
/apps/web/public/schemas/
/.refresh.dump

