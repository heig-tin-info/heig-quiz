# The exam corpus lives outside this (public) repository; a local copy must
# never reach an image.
corpus
# Downloaded by fetch-runtimes.mjs in a layer of its own (Dockerfile); a local
# copy would only bust the cache of the layers after `COPY . .`.
apps/web/public/runtimes
# apps/runner IS part of the build context: apps/runner/Dockerfile builds it
# from the repository root. The language images are built on the runner VM
# by apps/runner/images/build.sh, never from this context.
apps/runner/images
# apps/codespace is in the context only so the lockfile's workspace is whole;
# no image built from here installs or copies it (the app image deploys
# @quiz/api alone). Its student image is built on the engine VM (M6-04).
apps/codespace/images
