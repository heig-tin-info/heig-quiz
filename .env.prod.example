# Copy to .env.prod (chmod 600). Never put a real secret in this file.
LOG_LEVEL=info
SESSION_TTL_HOURS=12
# Process role (ADR-001): all (default) | web | worker. A single container
# carries everything today; `web`/`worker` split the roles without code change.
#WORKER_MODE=all

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
COOKIE_SECRET=

# Super administrator (single) -- teachers are managed in the admin screen
SUPER_ADMIN_EMAIL=

# --- OIDC (Switch edu-ID) ---
# Keycloak is a DEVELOPMENT identity provider and is not deployed here.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Either a client secret, or (recommended by SWITCH) a private key whose
# public JWK is registered in the Resource Registry.
#OIDC_CLIENT_SECRET=
#OIDC_PRIVATE_KEY_PATH=secrets/eduid-private-key.pem
#OIDC_PRIVATE_KEY_KID=quiz-eduid-2026

# AUTH_DEV_LOGIN and a pglite:// DATABASE_URL are refused under
# NODE_ENV=production: the process will not start. Do not set them here.
