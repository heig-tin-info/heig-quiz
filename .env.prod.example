# Copy to .env.prod (chmod 600). Never put a real secret in this file.
LOG_LEVEL=info
SESSION_TTL_HOURS=12
# Process role (ADR-001): all (default) | web | worker. A single container
# carries everything today; `web`/`worker` split the roles without code change.
#WORKER_MODE=all

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
COOKIE_SECRET=

# Super administrator (single) -- teachers are managed in the admin screen
SUPER_ADMIN_EMAIL=

# Affiliation scopes whose edu-ID `staff` becomes teacher without an
# invitation; another scope, or a bare `staff`, does not (roles.ts).
#STAFF_AFFILIATION_DOMAINS=heig-vd.ch,hes-so.ch

# --- OIDC (Switch edu-ID) ---
# Keycloak is a DEVELOPMENT identity provider and is not deployed here.
# The client is registered in the SWITCH Resource Registry with the redirect
# URI https://quiz.chevallier.io/app/auth/callback and the same public JWK as
# heig-classroom, hence the same private key and the same `kid`.
OIDC_ISSUER=https://login.eduid.ch/
OIDC_CLIENT_ID=
OIDC_PRIVATE_KEY_PATH=secrets/eduid-private-key.pem
OIDC_PRIVATE_KEY_KID=hgc-eduid-2026

# --- Code runner (ADR-016) ---
# The runner service lives on the code VM behind its own Caddy. Both sides
# hold the SAME token: here, and in /etc/quiz-runner/env over there.
# Generate with: openssl rand -hex 32
RUNNER_MODE=http
RUNNER_URL=https://code.chevallier.io:8443
RUNNER_TOKEN=

# --- Online workspace portal (ADR-047, M6-04) ---
# The engine VM's prod instance. The SAME secret as CODESPACE_LAUNCH_SECRET in
# /etc/quiz-codespace/prod/env over there, at least 32 characters, never
# staging's (apps/codespace/deploy/RUNBOOK.md, step 9). Both empty: the
# feature is off.
#CODESPACE_URL=https://code.chevallier.io
#CODESPACE_LAUNCH_SECRET=

# --- Reverse proxy and metrics ---
# The addresses Caddy reaches the API from, and nothing else: `req.ip` is what
# the room restriction (F-EVAL-12) and the attempt journal read. The default
# covers the native Caddy of this VM, whose peer is the Docker bridge gateway.
# Never list a range a student machine can sit on.
#TRUSTED_PROXIES=loopback,172.16.0.0/12
# Bearer token for GET /metrics (Prometheus). Empty = an admin session only;
# the endpoint is never public. Generate with: openssl rand -hex 32
#METRICS_TOKEN=

# --- Kiosk stations (ADR-051) ---
# off (default) | google. `mock` is refused here. With `google`, all four
# below are required, or the process will not start; the key file is the
# Verified Access service account's JSON key, mounted like the edu-ID PEM.
#KIOSK_ATTESTATION=off
#KIOSK_VA_KEY_FILE=secrets/verified-access-key.json
#KIOSK_GOOGLE_CUSTOMER_ID=
#KIOSK_ENROLLMENT_DOMAIN=
#KIOSK_EXTENSION_ID=

# --- LLM gateway (ADR-058) ---
# The master key that encrypts the Anthropic key entered in Administration >
# AI; keep a copy in the age vault (ADR-010). Empty = the gateway is off.
# At least 32 characters. Generate with: openssl rand -hex 32
#LLM_KEY_SECRET=
# The most the console may set as the daily spending cap (USD).
#LLM_DAILY_CAP_MAX_USD=100

# --- GitHub (ADR-035, docs/development/github-app.md) ---
# Quiz's production App, never heig-classroom's nor staging's. Written by
# `pnpm github:app` (or by hand); the key in ./secrets, mounted read-only.
# With an App id set, the process will not start without a readable key, the
# slug, the OAuth client and a webhook secret of at least 32 characters.
# All empty: the GitHub features are off.
#GITHUB_APP_ID=
#GITHUB_APP_PRIVATE_KEY_PATH=secrets/<slug>.private-key.pem
#GITHUB_APP_SLUG=
#GITHUB_WEBHOOK_SECRET=
#GITHUB_APP_CLIENT_ID=
#GITHUB_APP_CLIENT_SECRET=

# AUTH_DEV_LOGIN and a pglite:// DATABASE_URL are refused under
# NODE_ENV=production: the process will not start. Do not set them here.

# --- Notification channels (ADR-030) ---
# E-mail through Scaleway TEM (the classroom's project and sender domain).
# Empty = dry run: e-mails are logged, never sent.
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=
#MAIL_FROM=no-reply@chevallier.io
#MAIL_FROM_NAME=HEIG Quiz
# Microsoft Teams: the multi-tenant Entra application "HEIG Quiz"
# (docs/development/teams.md). Empty = the channel is off.
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
# The organizations whose Teams accounts may be linked: HEIG-VD. Empty admits
# every tenant, which is safe for a test app only (ADR-030).
TEAMS_ALLOWED_TENANTS=a372f724-c0b2-4ea0-abfb-0eb8c6f84e40
