# Copy to .env.prod (chmod 600). Never put a real secret in this file.
LOG_LEVEL=info
SESSION_TTL_HOURS=12
# Process role (ADR-001): all (default) | web | worker. A single container
# carries everything today; `web`/`worker` split the roles without code change.
#WORKER_MODE=all

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
COOKIE_SECRET=

# Super administrator (single) -- teachers are managed in the admin screen
SUPER_ADMIN_EMAIL=

# --- OIDC (Switch edu-ID) ---
# Keycloak is a DEVELOPMENT identity provider and is not deployed here.
# The client is registered in the SWITCH Resource Registry with the redirect
# URI https://quiz.chevallier.io/app/auth/callback and the same public JWK as
# heig-classroom, hence the same private key and the same `kid`.
OIDC_ISSUER=https://login.eduid.ch/
OIDC_CLIENT_ID=
OIDC_PRIVATE_KEY_PATH=secrets/eduid-private-key.pem
OIDC_PRIVATE_KEY_KID=hgc-eduid-2026

# --- Code runner (ADR-016) ---
# The runner service lives on the code VM behind its own Caddy. Both sides
# hold the SAME token: here, and in /etc/quiz-runner/env over there.
# Generate with: openssl rand -hex 32
RUNNER_MODE=http
RUNNER_URL=https://code.chevallier.io:8443
RUNNER_TOKEN=

# AUTH_DEV_LOGIN and a pglite:// DATABASE_URL are refused under
# NODE_ENV=production: the process will not start. Do not set them here.
