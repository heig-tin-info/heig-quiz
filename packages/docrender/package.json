{
  "name": "@quiz/docrender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@quiz/contracts": "workspace:*",
    "@quiz/domain": "workspace:*",
    "katex": "^0.18.7",
    "marked": "^18.0.13",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
