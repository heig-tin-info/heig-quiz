{
  "name": "@quiz/registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@quiz/core": "workspace:*",
    "@quiz/qt-circuit": "workspace:*",
    "@quiz/qt-code": "workspace:*",
    "@quiz/qt-cloze": "workspace:*",
    "@quiz/qt-mcq": "workspace:*",
    "@quiz/qt-short": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
