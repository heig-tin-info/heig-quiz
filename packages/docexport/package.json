{
  "name": "@quiz/docexport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./typst": {
      "types": "./dist/typst/index.d.ts",
      "default": "./dist/typst/index.js"
    },
    "./entities": {
      "types": "./dist/entities.d.ts",
      "default": "./dist/entities.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "marked": "^18.0.13",
    "tex2typst": "0.6.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
