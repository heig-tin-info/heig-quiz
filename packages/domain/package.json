{
  "name": "@quiz/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "0.58.0",
    "@quiz/core": "workspace:*",
    "ipaddr.js": "2.4.0",
    "mathjs": "15.2.0",
    "re2js": "2.8.6",
    "ts-fsrs": "^5.4.2",
    "yaml": "^2.9.1"
  }
}
