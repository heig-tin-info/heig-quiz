{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": false,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM"
    ]
