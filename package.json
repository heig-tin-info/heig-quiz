{
  "name": "heig-quiz",
  "private": true,
  "version": "0.1.0",
  "description": "Quiz platform for HEIG-VD teachers: question pools, live evaluations, automatic grading",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm -r --parallel --filter @quiz/api --filter @quiz/web --filter @quiz/runner dev",
    "dev:mock": "pnpm --filter @quiz/web dev:mock",
    "seed": "pnpm --filter @quiz/api seed",
    "smoke": "bash scripts/smoke.sh",
    "db:generate": "pnpm --filter @quiz/api db:generate",
    "docs:build": "zensical build",
    "docs:serve": "zensical serve",
    "docs:screenshots": "node apps/web/scripts/docs-screenshots.mjs"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.25.0": ">=0.28.1",
      "find-my-way@<9.7.0": "^9.9.0",
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.8",
      "dompurify@<3.4.13": "^3.4.16",
      "postcss@<8.5.23": "^8.5.28",
      "nanoid@<3.3.18": "^3.3.19",
      "brace-expansion@>=4.0.0 <5.0.9": "^5.0.12"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^6.0.3"
  }
}
