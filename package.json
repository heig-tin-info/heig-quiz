{
  "name": "heig-quiz",
  "private": true,
  "version": "0.1.0",
  "description": "Quiz platform for HEIG-VD teachers: question pools, live evaluations, automatic grading",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm -r --parallel --filter @quiz/api --filter @quiz/web dev",
    "dev:mock": "pnpm --filter @quiz/web dev:mock",
    "seed": "pnpm --filter @quiz/api seed",
    "smoke": "bash scripts/smoke.sh",
    "db:generate": "pnpm --filter @quiz/api db:generate"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.25.0": ">=0.28.1"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
