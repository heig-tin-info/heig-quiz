# Vhost of quiz.dev.chevallier.io, the staging environment (ADR-028).
#
# Same VM, same native Caddy as production (Caddyfile): one more fragment.
# As `srv`:
#   cp Caddyfile.staging /etc/caddy/conf.d/quiz-staging.caddy && sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile && sudo systemctl reload caddy
quiz.dev.chevallier.io {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No framing by another site (click-jacking), no plugin content, no
		# <base> rewriting every relative URL. The SPA frames nothing of its own.
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
		# Staging is never a search result a student could land on.
		X-Robots-Tag "noindex, nofollow"
	}

	# ADR-030: Teams frames the tab `/teams` on its own origins. That page has
	# no session (SameSite=Lax cookies never reach it), so there is nothing on
	# it to click-jack: framing is allowed there, and only there.
	@teamsTab path /teams
	header @teamsTab {
		-X-Frame-Options
		Content-Security-Policy "object-src 'none'; base-uri 'self'"
	}

	handle /app/api/events {
		reverse_proxy localhost:3003 {
			flush_interval -1
		}
	}

	# 3002 is production quiz: staging listens on 3003 (loopback).
	handle {
		reverse_proxy localhost:3003
	}
}
