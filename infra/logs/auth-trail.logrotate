# The rotation of /var/log/auth-trail.log on BOTH VMs (#872), installed by
# hand as /etc/logrotate.d/auth-trail. The period and why,
# docs/development/deployment.md §7, Host logs. The postrotate is the one
# Ubuntu's /etc/logrotate.d/rsyslog runs.
/var/log/auth-trail.log {
	weekly
	rotate 26
	maxage 183
	missingok
	notifempty
	compress
	delaycompress
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}
