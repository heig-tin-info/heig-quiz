# NATIVE Caddy (apt) -- copy to /etc/caddy/Caddyfile, then:
#   sudo systemctl reload caddy
quiz.example.ch {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# SSE: unbuffered stream (ADR-005). HTTP/2 is what lifts the six-connection
	# limit a long-lived stream would otherwise eat into (docs/spec/05, 5.4).
	handle /app/events {
		reverse_proxy localhost:3000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy localhost:3000
	}
}
