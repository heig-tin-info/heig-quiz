# Vhost of quiz.chevallier.io.
#
# The VM hosts three services behind one NATIVE Caddy (apt). The host's
# /etc/caddy/Caddyfile only holds `import /etc/caddy/conf.d/*.caddy`: each
# project drops its own fragment and never overwrites a neighbour's.
# As `srv` (conf.d is group-writable; sudo covers exactly these two commands):
#   cp Caddyfile /etc/caddy/conf.d/quiz.caddy && sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile && sudo systemctl reload caddy
quiz.chevallier.io {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# SSE: unbuffered stream (ADR-005). HTTP/2 is what lifts the six-connection
	# limit a long-lived stream would otherwise eat into (docs/spec/05, 5.4).
	handle /app/api/events {
		reverse_proxy localhost:3002 {
			flush_interval -1
		}
	}

	# 3000 is heig-classroom, 3001 is tb: quiz listens on 3002 (loopback).
	handle {
		reverse_proxy localhost:3002
	}
}
